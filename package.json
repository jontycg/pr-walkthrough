{
  "name": "pr-walkthrough",
  "version": "0.1.0",
  "description": "Browser extension that transforms PR reviews into guided tours",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "test": "jest"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/tests"
    ]
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^28.0.1",
    "esbuild": "^0.27.4",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jsdom": "^29.0.1",
    "ts-jest": "^29.4.6",
    "typescript": "^6.0.2"
  }
}
