{
  "manifest_version": 3,
  "name": "PR Narrative",
  "version": "0.1.0",
  "description": "Guided tours through GitHub pull requests",
  "content_scripts": [
    {
      "matches": ["https://github.com/*/pull/*/files*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [],
  "host_permissions": ["https://github.com/*", "https://api.github.com/*"]
}
